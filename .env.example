# 로컬 docker compose용 예시. 운영 값은 Secrets Manager(maemusae/ops) -> External Secrets로 넣는다

# 접수 토큰. Alertmanager는 Authorization: Bearer <ALERTMANAGER_TOKEN>, kube-bench Job은 <SECURITY_REPORT_TOKEN>
ALERTMANAGER_TOKEN=change-me
SECURITY_REPORT_TOKEN=change-me-too

# compose가 덮어쓴다. compose 밖에서 띄울 때만 쓴다
REDIS_URL=redis://localhost:56379/0
DATABASE_URL=postgresql://ops:ops@localhost:55432/incident
SECURITY_DATABASE_URL=postgresql://ops:ops@localhost:55432/security

# LLM. 키 없이 흐름만 볼 때는 fake:light, fake:heavy
OPENAI_API_KEY=
LIGHT_MODEL=fake:light
HEAVY_MODEL=fake:heavy
# 운영 예: LIGHT_MODEL=openai:gpt-4.1-mini, HEAVY_MODEL=openai:gpt-4.1 (모델 이름과 단가는 OpenAI 문서에서 확인 후 쓴다)
# 100만 토큰당 [입력, 출력] USD. 표에 없는 모델은 0으로 계산되어 예산 상한이 듣지 않는다
MODEL_PRICES={"openai:gpt-4.1-mini":[0.40,1.60],"openai:gpt-4.1":[2.0,8.0]}
INCIDENT_BUDGET_USD=0.5

# 근거 수집. 비우면 조회하지 않는다
LOKI_URL=

# Discord 봇(카드 게시 + 승인 버튼). 비우면 카드는 로그로만 남는다
DISCORD_BOT_TOKEN=
DISCORD_INCIDENT_CHANNEL_ID=
DISCORD_SECURITY_CHANNEL_ID=
# 승인할 수 있는 역할 ID. 쉼표로 나누고, 하나라도 가진 사람이 승인한다. 비우면 아무도 승인하지 못한다
DISCORD_APPROVER_ROLE_IDS=

# 롤백 GitHub App(INFRA 레포 contents, pull requests 쓰기). 이미지 PR App과 다른 App이다. 비우면 배포 이력과 롤백 제안이 빠진다
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM 전체. 줄바꿈은 그대로 넣는다(.env에서는 큰따옴표로 감싼다)
GITHUB_APP_PRIVATE_KEY=
INFRA_REPO=saebyeok-baesong/INFRA-maemusae
INFRA_BRANCH=main
IMAGES_PATH=gitops/apps/images.yaml
ROLLBACK_APPS=["web","api"]
ROLLBACK_WINDOW_MIN=30

SECURITY_REPORT_HOUR_KST=9

# CI 보안 스캔 결과 버킷(maemusae-security-scans-<account_id>). python -m app.security.ingest_s3만 쓴다
SECURITY_SCAN_BUCKET=
