# demo/.env로 복사해 쓴다. 모두 비우면 가짜 LLM, Discord 없이(메시지는 ops-worker 로그) 돈다

# 있으면 openai:gpt-4.1-mini(분류), openai:gpt-4.1(원인 분석)을 쓴다. 모델을 바꾸려면 LIGHT_MODEL, HEAVY_MODEL
OPENAI_API_KEY=
# LIGHT_MODEL=openai:gpt-4.1-mini
# HEAVY_MODEL=openai:gpt-4.1

# 있으면 장애 채널로 보내고 승인 봇(ops-approvals)도 띄운다
DISCORD_BOT_TOKEN=
DISCORD_INCIDENT_CHANNEL_ID=
DISCORD_SECURITY_CHANNEL_ID=
DISCORD_APPROVER_ROLE_IDS=
